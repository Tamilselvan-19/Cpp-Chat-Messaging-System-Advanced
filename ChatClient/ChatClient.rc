#include "resource.h"
#include <afxres.h>

IDD_CHATCLIENT_DIALOG DIALOGEX 0, 0, 420, 260
STYLE WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Cpp Chat Client"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Server IP:", IDC_STATIC, 12, 15, 55, 16
    EDITTEXT        IDC_EDIT_SERVERIP, 80, 12, 120, 20, ES_AUTOHSCROLL

    LTEXT           "Port:", IDC_STATIC, 214, 15, 28, 16
    EDITTEXT        IDC_EDIT_PORT, 250, 12, 60, 20, ES_NUMBER

    LTEXT           "User ID:", IDC_STATIC, 12, 45, 55, 16
    EDITTEXT        IDC_EDIT_USERID, 80, 42, 120, 20, ES_AUTOHSCROLL

    LTEXT           "Password:", IDC_STATIC, 214, 45, 50, 16
    EDITTEXT        IDC_EDIT_PASSWORD, 270, 42, 120, 20, ES_PASSWORD | ES_AUTOHSCROLL

    CONTROL         "Connect", IDC_BTN_CONNECT, "Button", WS_TABSTOP | WS_VISIBLE, 12, 80, 80, 24
    CONTROL         "Disconnect", IDC_BTN_DISCONNECT, "Button", WS_TABSTOP | WS_VISIBLE, 100, 80, 90, 24
    CONTROL         "Send", IDC_BTN_SEND, "Button", WS_TABSTOP | WS_VISIBLE, 200, 80, 80, 24

    LTEXT           "Chat:", IDC_STATIC, 12, 118, 70, 16
    LISTBOX         IDC_LIST_CHAT, 12, 136, 396, 80, LBS_NOTIFY | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    EDITTEXT        IDC_EDIT_MESSAGE, 12, 226, 310, 22, ES_AUTOHSCROLL

    LTEXT           "Status:", IDC_STATIC, 12, 250, 38, 16
    LTEXT           "", IDC_STATIC_STATUS, 60, 250, 150, 16

    LTEXT           "Heartbeat:", IDC_STATIC, 220, 250, 58, 16
    LTEXT           "-", IDC_STATIC_HEARTBEAT, 285, 250, 120, 16
END
